# 复制为根目录 .env 后填写。服务端通过 --env-file 读取。

# ===== 阿里云智能语音交互（NLS）=====
# RAM 访问密钥，成对出现；建议使用只授权 NLS 的子账号
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 智能语音交互控制台 → 项目管理 → 创建项目后拿到的 AppKey
NLS_APP_KEY=
# 网关地址：上海 / 北京 / 深圳 / 广州，按项目所属地域改
NLS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# 实时语音识别
NLS_ASR_SAMPLE_RATE=16000
# 静音多久判定一句话说完（毫秒，200-6000）
NLS_ASR_MAX_SENTENCE_SILENCE_MS=700
# 语义断句：参考上下文断句，可提升识别准确率（代价是断句稍慢）
NLS_ASR_SEMANTIC_SENTENCE=true
# 可选：控制台「自学习」里创建的热词表 ID / 定制语言模型 ID，用于人名、专有词
NLS_ASR_VOCABULARY_ID=
NLS_ASR_CUSTOMIZATION_ID=

# 语音合成音色（NLS 音色名，非控制台中文名）
# 已验证可用：aixia / aitong / aiqi / aijia / aina / sitong / sijia / siyue /
#            xiaomei / zhitian(知甜) / zhishuo / zhichu / zhide
NLS_TTS_VOICE=zhitian
NLS_TTS_SAMPLE_RATE=24000
# 音量 0-100
NLS_TTS_VOLUME=50
# 语速 -500-500，0 为正常
NLS_TTS_SPEECH_RATE=0
# 音调 -500-500，0 为正常
NLS_TTS_PITCH_RATE=0

# ===== DeepSeek 大模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 支持看图需要 deepseek-flash（文本+图片），纯文本可用 deepseek-chat
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.8
# 联网搜索：走 DeepSeek Search API，共用上面的 Key，不需要额外服务
WEB_SEARCH_ENABLED=true
WEB_SEARCH_COUNT=5

# ===== 和风天气 =====
# 控制台「设置 → 开发者信息」申请 API Key
QWEATHER_API_KEY=
# 专属 API Host（新账号必填），形如 abcdefg.re.qweatherapi.com
QWEATHER_API_HOST=

# ===== 眼睛（摄像头） =====
EYE_ENABLED=true
EYE_INTERVAL_MS=5000
EYE_MAX_AGE_MS=20000

# ===== 本地声纹识别 =====
# 首次使用先跑 pnpm voiceprint:model 下载模型
VOICEPRINT_ENABLED=true
# 不填时默认 apps/server/models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
# VOICEPRINT_MODEL_PATH=
# 余弦相似度阈值，越高越保守（0~1），默认 0.6
VOICEPRINT_THRESHOLD=0.6

# ===== 主动说话 =====
PROACTIVE_ENABLED=true
PROACTIVE_IDLE_MIN_MS=90000
PROACTIVE_IDLE_MAX_MS=180000
PROACTIVE_MIN_GAP_MS=60000

# ===== 空闲观察与自我积累 =====
LEARN_ENABLED=true
LEARN_MIN_INTERVAL_MS=300000
LEARN_MAX_INTERVAL_MS=900000

# ===== 对话行为 =====
# 助手名称：前端标题、人设和自我介绍都用它，改这一处即可
ASSISTANT_NAME=悠悠

# 人设覆盖，不填使用内置默认提示词
# SYSTEM_PROMPT=

# MCP 服务配置（可选）。默认读取仓库根目录 mcp.json，文件不存在则不加载
# MCP_CONFIG_PATH=./mcp.json

# 本地数据目录（记忆与沙箱文件），默认 apps/server/data
# COMPANION_DATA_DIR=

# 服务端口（前端 Vite 默认代理到 127.0.0.1:8787）
PORT=8787
